# Copy outside the checkout to /etc/ha/connected.env; owner root, mode 0600.
# Replace every example value before starting. Never commit populated values.
HA_PUBLIC_ORIGIN=https://tax.example.invalid
HA_AUTH_PROVIDER=keycloak
HA_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/ha?sslmode=verify-full&sslrootcert=/etc/ha/database-ca.crt
HA_KEYCLOAK_ISSUER=https://identity.example.invalid/realms/ha
HA_KEYCLOAK_CLIENT=ha-connected
HA_DOCUMENT_STORAGE=spaces
HA_SPACES_REGION=nyc3
HA_SPACES_BUCKET=REPLACE_PRIVATE_VERSIONED_BUCKET
HA_SPACES_ACCESS_KEY=REPLACE_ACCESS_KEY
HA_SPACES_SECRET_KEY=REPLACE_SECRET_KEY
HA_DOCUMENT_KEY_DIRECTORY=/etc/ha/keys
HA_DOCUMENT_ACTIVE_KEY_ID=initial
HA_CLAMD_SOCKET=/run/clamav/clamd.ctl
