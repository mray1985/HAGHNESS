[Unit]
Description=HA verified encrypted backup capture
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ha-backup
Group=ha-backup
WorkingDirectory=/opt/ha/current
EnvironmentFile=/etc/ha-backup/backup.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ha/venv/bin/python -m ha.connected.backup_runner
TimeoutStartSec=4h
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/ha-backup/document-keys /etc/ha-backup/recovery-keys
ReadWritePaths=/var/lib/ha-backup
