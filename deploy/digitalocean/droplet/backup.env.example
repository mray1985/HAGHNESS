# Disabled until manual capture, restoration and key recovery are verified.
HA_BACKUP_ENABLED=false
HA_BACKUP_DATABASE_URL=
HA_BACKUP_DIRECTORY=/var/lib/ha-backup
HA_BACKUP_KEY_DIRECTORY=/etc/ha-backup/recovery-keys
HA_BACKUP_KEY_ID=
HA_BACKUP_PG_DUMP=/usr/bin/pg_dump
HA_DOCUMENT_KEY_DIRECTORY=/etc/ha-backup/document-keys
HA_DOCUMENT_ACTIVE_KEY_ID=
HA_SPACES_REGION=
HA_SPACES_BUCKET=
HA_SPACES_ACCESS_KEY=
HA_SPACES_SECRET_KEY=
# Use a read-only source Spaces credential and the dedicated DB reader.
# Keep historical document and backup recovery keys externally recoverable.
